+// On 32-bit ARM softfp (arm-linux-androideabi), Clang returns the 8-byte YGSize struct via a hidden
+// sret pointer in r0 whereas Zig's C ABI lowers extern struct { f32, f32 } in r0:r1. Keeping the
+// YGMeasureFunc trampoline in C++ ensures Clang handles sret and invokes Zig via out-pointers.
+static OTYogaMeasureOutFunc g_measure_out_js = nullptr;
+static OTYogaMeasureOutFunc g_measure_out_native = nullptr;
+
+static YGSize otYogaTrampolineMeasureJs(
+    YGNodeConstRef node, float width, YGMeasureMode width_mode,
+    float height, YGMeasureMode height_mode) {
+  YGSize result = {YGUndefined, YGUndefined};
+  if (g_measure_out_js) {
+    g_measure_out_js(node, width, width_mode, height, height_mode, &result.width, &result.height);
+  }
+  return result;
+}
+
+static YGSize otYogaTrampolineMeasureNative(
+    YGNodeConstRef node, float width, YGMeasureMode width_mode,
+    float height, YGMeasureMode height_mode) {
+  YGSize result = {YGUndefined, YGUndefined};
+  if (g_measure_out_native) {
+    g_measure_out_native(node, width, width_mode, height, height_mode, &result.width, &result.height);
+  }
+  return result;
+}
+
+uint32_t otYogaNodeSetMeasureOutFunc(YGNodeRef node, OTYogaMeasureOutFunc callback,
+                                     uint32_t is_native,
+                                     uint32_t height_cap_only_clamps) noexcept {
+  if (!node || (callback && YGNodeGetChildCount(node))) return OT_YOGA_INVALID_ARGUMENT;
+  if (callback) {
+    if (is_native) {
+      g_measure_out_native = callback;
+    } else {
+      g_measure_out_js = callback;
+    }
+  }
+  YGMeasureFunc trampoline = nullptr;
+  if (callback) {
+    trampoline = is_native ? &otYogaTrampolineMeasureNative : &otYogaTrampolineMeasureJs;
+  }
+  return checked([&] {
+    YGNodeSetMeasureFunc(node, trampoline);
+    facebook::yoga::resolveRef(node)->setHeightCapOnlyClamps(height_cap_only_clamps != 0);
+  });
+}
+
 void otYogaNodeInvalidateMeasure(YGNodeRef node) noexcept {
   // No allocation or fallible Yoga operation remains after provider acceptance.
   // Managed dirtied callbacks contain host errors before returning here.
