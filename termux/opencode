#!/data/data/com.termux/files/usr/bin/sh
# Native Termux launcher for OpenCode (with OpenTUI) on 32-bit ARM (armeabi-v7a, API 24+).
# Tuned for older Android 7/8 devices with limited RAM (<= 2 GB).
set -eu

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
NODE="${OPENCODE_NODE_BIN:-$PREFIX/bin/node}"
HERE="$PREFIX/lib/opencode"
NATIVE_LIB="$HERE/assets/@opentui/core-android-arm/libopentui.so"

if [ ! -x "$NODE" ]; then
  echo "Error: Node.js not found at $NODE. Install it with: pkg install nodejs" >&2
  exit 127
fi

# Detect Node.js FFI and system CA flag support
HAS_FFI=0
NODE_FLAGS=""
if "$NODE" --experimental-ffi -e "" >/dev/null 2>&1; then
  HAS_FFI=1
  NODE_FLAGS="$NODE_FLAGS --experimental-ffi"
fi
if "$NODE" --use-system-ca -e "" >/dev/null 2>&1; then
  NODE_FLAGS="$NODE_FLAGS --use-system-ca"
fi

# Cap V8 old-space heap to stay within 32-bit virtual address space and <= 2 GB RAM devices.
# Override with OPENCODE_MAX_OLD_SPACE_SIZE=<MB> (e.g., 384 on 1 GB RAM, 768 on 3+ GB RAM).
MAX_HEAP="${OPENCODE_MAX_OLD_SPACE_SIZE:-512}"
NODE_FLAGS="$NODE_FLAGS --max-old-space-size=$MAX_HEAP --disable-warning=ExperimentalWarning"

# Detect whether the invocation will launch the interactive OpenTUI frontend
WANTS_TUI=1
HAS_SERVER_OR_STANDALONE=0
FIRST_POS=""
for arg in "$@"; do
  case "$arg" in
    --help|-h|--version|-v|--completions|--completions=*)
      WANTS_TUI=0
      ;;
    --server|--server=*|--standalone)
      HAS_SERVER_OR_STANDALONE=1
      ;;
    -*)
      ;;
    *)
      if [ -z "$FIRST_POS" ]; then
        FIRST_POS="$arg"
      fi
      ;;
  esac
done

case "$FIRST_POS" in
  serve|service|run|models|auth|login|mcp|plugin|session|stats|api|acp|debug|machine|pair|reload|upgrade|update|uninstall|mini)
    WANTS_TUI=0
    ;;
esac

if [ "$WANTS_TUI" -eq 1 ] && [ "$HAS_FFI" -eq 0 ]; then
  echo "Error: OpenCode TUI requires Node.js >= 26.4.0 with --experimental-ffi support." >&2
  echo "Current Node.js: $("$NODE" -v 2>/dev/null || echo unknown)" >&2
  echo "Run: pkg update && pkg upgrade nodejs" >&2
  echo "Tip: You can still run headless mode with: opencode serve --port 4096" >&2
  exit 1
fi

# Point OpenTUI directly at the cross-compiled Android armv7a Bionic shared library
if [ -f "$NATIVE_LIB" ]; then
  export OPENTUI_LIB_PATH="${OPENTUI_LIB_PATH:-$NATIVE_LIB}"
fi

# Disable optional native desktop modules that have no android-arm prebuilds
export OPENCODE_DISABLE_FILEWATCHER="${OPENCODE_DISABLE_FILEWATCHER:-1}"
export OPENCODE_DISABLE_FFF="${OPENCODE_DISABLE_FFF:-1}"
export OPENCODE_DISABLE_AUTOUPDATE="${OPENCODE_DISABLE_AUTOUPDATE:-1}"
export COLORTERM="${COLORTERM:-truecolor}"

# Default to --standalone when launching the TUI on 32-bit Android so only ONE Node.js
# process runs instead of two (saves ~150-250 MB RAM on <= 2 GB devices).
# Set OPENCODE_TERMUX_STANDALONE=0 to use the background daemon mode instead.
if [ "$WANTS_TUI" -eq 1 ] && [ "$HAS_SERVER_OR_STANDALONE" -eq 0 ] && [ "${OPENCODE_TERMUX_STANDALONE:-1}" != "0" ]; then
  # shellcheck disable=SC2086
  exec "$NODE" $NODE_FLAGS "$HERE/opencode.mjs" --standalone "$@"
fi

# shellcheck disable=SC2086
exec "$NODE" $NODE_FLAGS "$HERE/opencode.mjs" "$@"
